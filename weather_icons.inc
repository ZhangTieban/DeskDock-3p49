static const lv_image_dsc_t *weatherIconImage(int code, bool day) {
  switch (code) {
    case 0:
      return day ? &kWeatherClearDay : &kWeatherClearNight;
    case 1:
    case 2:
      return day ? &kWeatherPartialDay : &kWeatherPartialNight;
    case 3:
      return &kWeatherCloudy;
    case 45:
    case 48:
      return &kWeatherFog;
    case 51:
    case 53:
    case 55:
      return day ? &kWeatherDrizzleDay : &kWeatherDrizzleNight;
    case 56:
    case 57:
    case 66:
    case 67:
      return day ? &kWeatherFreezingDay : &kWeatherFreezingNight;
    case 61:
    case 63:
    case 65:
    case 80:
    case 81:
    case 82:
      return day ? &kWeatherRainDay : &kWeatherRainNight;
    case 71:
    case 73:
    case 75:
    case 77:
    case 85:
    case 86:
      return day ? &kWeatherSnowDay : &kWeatherSnowNight;
    case 95:
    case 97:
      return day ? &kWeatherThunderDay : &kWeatherThunderNight;
    case 96:
    case 99:
      return day ? &kWeatherHailDay : &kWeatherHailNight;
    default: return &kWeatherUnknown;
  }
}
