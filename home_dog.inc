static constexpr int kDogLaneWidth = 296;
static constexpr int kDogLeft = 4, kDogRight = kDogLaneWidth - kShibaWidth - 4;
static constexpr int kDogBowl = kDogRight - 4;
static constexpr uint32_t kDogTickMs = 80;
static constexpr uint16_t kDogPlayStart = 18000 / kDogTickMs;
static constexpr uint16_t kDogPlayEnd = 26000 / kDogTickMs;
static constexpr uint16_t kDogSitStart = 42000 / kDogTickMs;
static constexpr uint16_t kDogSitEnd = 48000 / kDogTickMs;
static constexpr uint16_t kDogNapStart = 62000 / kDogTickMs;
static constexpr uint16_t kDogDayCycle = 70000 / kDogTickMs;
enum class HomeDogSchedule : uint8_t { Day, Mealtime, Night };
static HomeDogSchedule homeDogSchedule = HomeDogSchedule::Day;

static void setHomeDogTime(int minute) {
  if (minute >= 22 * 60 || (minute >= 0 && minute < 6 * 60)) {
    homeDogSchedule = HomeDogSchedule::Night;
  } else if (minute == 7 * 60 + 30 || minute == 18 * 60) {
    homeDogSchedule = HomeDogSchedule::Mealtime;
  } else {
    homeDogSchedule = HomeDogSchedule::Day;
  }
}

static constexpr uint16_t homeDogColor(uint32_t rgb) {
  return ((rgb >> 8) & 0xF800) | ((rgb >> 5) & 0x07E0) | ((rgb >> 3) & 0x001F);
}

static void drawHomeDog(lv_obj_t *canvas, int x, int pose, bool mirror) {
  static constexpr uint16_t palette[] = {
    homeDogColor(kHomeBackground), homeDogColor(0xDC863B), homeDogColor(0xF9D39A),
    homeDogColor(0x62381F), homeDogColor(0xAE5727), homeDogColor(0xF5AF66), homeDogColor(0x81CBB6),
    homeDogColor(0x52B6F2), homeDogColor(0xC6ECFF)
  };
  static int lastX = -1, lastPose = -1;
  static bool lastMirror = false;
  if (x == lastX && pose == lastPose && mirror == lastMirror) return;
  const int first = lastX < 0 ? x : std::min(lastX, x);
  const int end = std::max(lastX, x) + kShibaWidth;
  const auto *sprite = kShibaPoses[pose];
  const int ballFrame = pose - kShibaPlayPose;
  lv_draw_buf_t *buffer = lv_canvas_get_draw_buf(canvas);
  // Draw the old and new locations into one buffer before submitting one dirty rectangle.
  for (int y = 0; y < kShibaHeight; ++y) {
    auto *row = reinterpret_cast<uint16_t *>(buffer->data + y * buffer->header.stride);
    std::fill(row + first, row + end, palette[0]);
    const bool flipRow = mirror && (pose != kShibaSleepPose || y >= 7);
    const int ballRow = ballFrame >= 0 ? y - kShibaBallY[ballFrame] : -1;
    for (int column = 0; column < kShibaWidth; ++column) {
      const int sourceX = flipRow ? kShibaWidth - 1 - column : column;
      char color = sprite[y][sourceX];
      if (pose < kShibaSleepPose && y >= 18 && color == '.') color = kShibaFeet[pose][y - 18][sourceX];
      if (ballRow >= 0 && ballRow < 5) {
        const int ballColumn = sourceX - kShibaBallX[ballFrame];
        if (ballColumn >= 0 && ballColumn < 5 && kShibaBall[ballRow][ballColumn] != '.')
          color = kShibaBall[ballRow][ballColumn];
      }
      if (color != '.') row[x + column] = palette[color - '0'];
    }
  }
  lastX = x;
  lastPose = pose;
  lastMirror = mirror;
  lv_area_t area;
  lv_obj_get_coords(canvas, &area);
  area.x2 = area.x1 + end - 1;
  area.x1 += first;
  lv_obj_invalidate_area(canvas, &area);
}

static void animateHomeDog(lv_timer_t *timer) {
  if (lv_screen_active() != homeScreen) return;
  auto *canvas = static_cast<lv_obj_t *>(lv_timer_get_user_data(timer));
  static int x = kDogLeft, direction = 1;
  static uint32_t tick = 0;
  static uint16_t daytimeTicks = 0;
  static HomeDogSchedule previous = HomeDogSchedule::Day;
  const HomeDogSchedule schedule = homeDogSchedule;
  if (schedule != previous) {
    daytimeTicks = 0;
    previous = schedule;
  }
  ++tick;

  if (schedule == HomeDogSchedule::Night) {
    drawHomeDog(canvas, x, kShibaSleepPose, direction < 0);
    return;
  }
  if (schedule == HomeDogSchedule::Day) {
    const uint16_t step = daytimeTicks;
    if (++daytimeTicks == kDogDayCycle) daytimeTicks = 0;
    int pose = -1;
    if (step >= kDogNapStart) pose = kShibaSleepPose;
    else if (step >= kDogSitStart && step < kDogSitEnd) pose = kShibaSitPose;
    else if (step >= kDogPlayStart && step < kDogPlayEnd) pose = kShibaPlayPose + (tick / 2) % 4;
    if (pose >= 0) {
      drawHomeDog(canvas, x, pose, direction < 0);
      return;
    }
  }

  if (schedule == HomeDogSchedule::Mealtime) {
    if (x == kDogBowl) {
      drawHomeDog(canvas, x, kShibaEatPose + (tick / 5) % 2, false);
      return;
    }
    direction = x < kDogBowl ? 1 : -1;
  } else if (x <= kDogLeft || x >= kDogRight) {
    direction = x <= kDogLeft ? 1 : -1;
  }
  x += direction;
  drawHomeDog(canvas, x, (tick / 2) % 4, direction < 0);
}

static void buildHomeDog() {
  lv_draw_buf_t *buffer = lv_draw_buf_create(kDogLaneWidth, kShibaHeight, LV_COLOR_FORMAT_RGB565, LV_STRIDE_AUTO);
  if (!buffer) return;
  lv_obj_t *canvas = lv_canvas_create(homeScreen);
  lv_canvas_set_draw_buf(canvas, buffer);
  lv_obj_set_pos(canvas, 8, 145);
  lv_canvas_fill_bg(canvas, lv_color_hex(kHomeBackground), LV_OPA_COVER);
  drawHomeDog(canvas, kDogLeft, 0, false);
  lv_timer_create(animateHomeDog, kDogTickMs, canvas);
}
