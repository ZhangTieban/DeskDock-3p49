static constexpr char kShibaBall[5][6] = {".777.", "78777", "77877", "77777", ".777."};
static constexpr int kShibaBallX[] = {34, 35, 34, 33};
static constexpr int kShibaBallY[] = {21, 17, 15, 18};
static constexpr int kShibaSleepPose = 4, kShibaEatPose = 5, kShibaSitPose = 7, kShibaPlayPose = 8;
