  kShibaBody, kShibaBody, kShibaBody, kShibaBody, kShibaAsleep,
  kShibaEating[0], kShibaEating[1], kShibaSitting,
  kShibaPlaying, kShibaPlaying, kShibaPlaying, kShibaPlaying
